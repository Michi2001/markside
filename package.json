{
  "name": "markdown-live-editor",
  "displayName": "Markdown Live Editor",
  "description": "Obsidian-like live preview editing for Markdown files, with image paste and Claude selection hand-off.",
  "version": "0.1.0",
  "publisher": "michael",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdLive.editor",
        "displayName": "Markdown Live Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "mdLive.pdf",
        "displayName": "PDF with Notes",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "mdLive.open",
        "title": "Open in Live Editor",
        "category": "Markdown Live",
        "icon": "$(edit)"
      },
      {
        "command": "mdLive.openAsText",
        "title": "Open as Raw Markdown",
        "category": "Markdown Live",
        "icon": "$(code)"
      },
      {
        "command": "mdLive.sendSelectionToClaude",
        "title": "Send Selection to Claude (Alt+K)",
        "category": "Markdown Live",
        "icon": "$(sparkle)"
      },
      {
        "command": "mdLive.insertDrawing",
        "title": "Insert Handwriting (Alt+D)",
        "category": "Markdown Live",
        "icon": "$(pencil)"
      },
      {
        "command": "mdLive.showIpadUrl",
        "title": "Draw on iPad: Show Address",
        "category": "Markdown Live"
      },
      {
        "command": "mdLive.renewIpadUrl",
        "title": "Draw on iPad: New Address (invalidate the old one)",
        "category": "Markdown Live"
      },
      {
        "command": "mdLive.chooseDrawingDevice",
        "title": "Choose Drawing Device",
        "category": "Markdown Live",
        "icon": "$(device-mobile)"
      },
      {
        "command": "mdLive.chooseDrawingDevice.mac",
        "title": "Choose Drawing Device",
        "category": "Markdown Live",
        "icon": "$(device-desktop)"
      },
      {
        "command": "mdLive.chooseDrawingDevice.ipad",
        "title": "Choose Drawing Device",
        "category": "Markdown Live",
        "icon": "$(device-mobile)"
      },
      {
        "command": "mdLive.chooseDrawingDevice.ipadUsb",
        "title": "Choose Drawing Device",
        "category": "Markdown Live",
        "icon": "$(plug)"
      },
      {
        "command": "mdLive.chooseDrawingDevice.sidecar",
        "title": "Choose Drawing Device",
        "category": "Markdown Live",
        "icon": "$(screen-full)"
      },
      {
        "command": "mdLive.toggleExplanations",
        "title": "Hide Claude's Explanations",
        "category": "Markdown Live",
        "icon": "$(lightbulb)"
      },
      {
        "command": "mdLive.toggleExplanations.off",
        "title": "Show Claude's Explanations",
        "category": "Markdown Live",
        "icon": "$(lightbulb-empty)"
      },
      {
        "command": "mdLive.explainSlides",
        "title": "Explain Slides with Claude…",
        "category": "Markdown Live",
        "icon": "$(sparkle)"
      },
      {
        "command": "mdLive.explainSlides.running",
        "title": "Claude Is Explaining Slides… (Stop)",
        "category": "Markdown Live",
        "icon": "$(loading~spin)"
      },
      {
        "command": "mdLive.chooseTheme",
        "title": "Choose Color Mode",
        "category": "Markdown Live",
        "icon": "$(color-mode)"
      },
      {
        "command": "mdLive.chooseFontSize",
        "title": "Choose Font Size",
        "category": "Markdown Live",
        "icon": "$(text-size)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdLive.open",
          "when": "editorLangId == markdown && !activeCustomEditorId",
          "group": "navigation@1"
        },
        {
          "command": "mdLive.openAsText",
          "when": "activeCustomEditorId == mdLive.editor",
          "group": "navigation@1"
        },
        {
          "command": "mdLive.sendSelectionToClaude",
          "when": "activeCustomEditorId == mdLive.editor",
          "group": "navigation@2"
        },
        {
          "command": "mdLive.chooseDrawingDevice.mac",
          "when": "(activeCustomEditorId == mdLive.editor || activeCustomEditorId == mdLive.pdf) && config.mdLive.drawingDevice == mac",
          "group": "navigation@3"
        },
        {
          "command": "mdLive.chooseDrawingDevice.ipad",
          "when": "(activeCustomEditorId == mdLive.editor || activeCustomEditorId == mdLive.pdf) && config.mdLive.drawingDevice == ipad",
          "group": "navigation@3"
        },
        {
          "command": "mdLive.chooseDrawingDevice.ipadUsb",
          "when": "(activeCustomEditorId == mdLive.editor || activeCustomEditorId == mdLive.pdf) && config.mdLive.drawingDevice == ipadUsb",
          "group": "navigation@3"
        },
        {
          "command": "mdLive.chooseDrawingDevice.sidecar",
          "when": "(activeCustomEditorId == mdLive.editor || activeCustomEditorId == mdLive.pdf) && config.mdLive.drawingDevice == sidecar",
          "group": "navigation@3"
        },
        {
          "command": "mdLive.explainSlides",
          "when": "activeCustomEditorId == mdLive.pdf && !mdLive.explaining",
          "group": "navigation@2"
        },
        {
          "command": "mdLive.explainSlides.running",
          "when": "activeCustomEditorId == mdLive.pdf && mdLive.explaining",
          "group": "navigation@2"
        },
        {
          "command": "mdLive.toggleExplanations",
          "when": "activeCustomEditorId == mdLive.pdf && config.mdLive.pdfExplanations",
          "group": "navigation@2"
        },
        {
          "command": "mdLive.toggleExplanations.off",
          "when": "activeCustomEditorId == mdLive.pdf && !config.mdLive.pdfExplanations",
          "group": "navigation@2"
        },
        {
          "command": "mdLive.chooseTheme",
          "when": "(activeCustomEditorId == mdLive.editor || activeCustomEditorId == mdLive.pdf)",
          "group": "navigation@4"
        },
        {
          "command": "mdLive.chooseFontSize",
          "when": "(activeCustomEditorId == mdLive.editor || activeCustomEditorId == mdLive.pdf)",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "mdLive.open",
          "when": "editorLangId == markdown && !activeCustomEditorId"
        },
        {
          "command": "mdLive.openAsText",
          "when": "activeCustomEditorId == mdLive.editor"
        },
        {
          "command": "mdLive.sendSelectionToClaude",
          "when": "activeCustomEditorId == mdLive.editor"
        },
        {
          "command": "mdLive.insertDrawing",
          "when": "activeCustomEditorId == mdLive.editor"
        },
        {
          "command": "mdLive.chooseDrawingDevice",
          "when": "(activeCustomEditorId == mdLive.editor || activeCustomEditorId == mdLive.pdf)"
        },
        {
          "command": "mdLive.chooseDrawingDevice.mac",
          "when": "false"
        },
        {
          "command": "mdLive.chooseDrawingDevice.ipad",
          "when": "false"
        },
        {
          "command": "mdLive.chooseDrawingDevice.ipadUsb",
          "when": "false"
        },
        {
          "command": "mdLive.chooseDrawingDevice.sidecar",
          "when": "false"
        },
        {
          "command": "mdLive.toggleExplanations",
          "when": "activeCustomEditorId == mdLive.pdf"
        },
        {
          "command": "mdLive.toggleExplanations.off",
          "when": "false"
        },
        {
          "command": "mdLive.explainSlides",
          "when": "activeCustomEditorId == mdLive.pdf"
        },
        {
          "command": "mdLive.explainSlides.running",
          "when": "false"
        },
        {
          "command": "mdLive.chooseTheme",
          "when": "(activeCustomEditorId == mdLive.editor || activeCustomEditorId == mdLive.pdf)"
        },
        {
          "command": "mdLive.chooseFontSize",
          "when": "(activeCustomEditorId == mdLive.editor || activeCustomEditorId == mdLive.pdf)"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Live Editor",
      "properties": {
        "mdLive.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Follow the current VS Code color theme.",
            "Always use a light editor.",
            "Always use a dark editor."
          ],
          "description": "Color mode of the Markdown Live Editor."
        },
        "mdLive.fontSize": {
          "type": "number",
          "default": 16,
          "minimum": 8,
          "maximum": 40,
          "description": "Default font size of notes (px) at 100 % zoom; headings and code scale with it. 'Choose Font Size' sets a size for a single note or PDF."
        },
        "mdLive.pdfNotesWidth": {
          "type": "number",
          "default": 360,
          "minimum": 200,
          "maximum": 1200,
          "description": "Space reserved for the notes column next to PDFs when fitting the pages at 100 % zoom (px). The column always fills the rest of the window; zooming magnifies notes and pages together."
        },
        "mdLive.pdfExplanations": {
          "type": "boolean",
          "default": true,
          "description": "Show Claude's explanations of the slides (paper.pdf.claude.md, written by the explain-slides skill) next to PDFs."
        },
        "mdLive.drawingDevice": {
          "type": "string",
          "enum": [
            "mac",
            "ipad",
            "ipadUsb",
            "sidecar"
          ],
          "default": "mac",
          "enumDescriptions": [
            "Draw in the editor window.",
            "Draw on an iPad: open the address from 'Draw on iPad: Show Address' in Safari there (same network).",
            "Like iPad, but the server only accepts connections over the USB cable to the iPad (recommended in public networks such as eduroam). Use the 169.254.x.x address from 'Draw on iPad: Show Address'.",
            "Draw in a browser window on the Sidecar display (opened full screen in its own Chrome window if Chrome is installed); the server is only reachable from the Mac itself."
          ],
          "description": "Where the handwriting canvas (Alt+D, double-click on a drawing) opens."
        },
        "mdLive.sidecarIpad": {
          "type": "string",
          "default": "",
          "description": "Name of the iPad that Sidecar mode connects to automatically when no Sidecar display is present (as listed under Displays in Control Center, e.g. 'iPad von Michael'; a trailing number like ' (6)' is optional). Empty: never connect automatically."
        },
        "mdLive.ipadPort": {
          "type": "number",
          "default": 8765,
          "description": "Port of the local server for drawing on the iPad."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "vscode:prepublish": "npm run build",
    "watch": "node esbuild.mjs --watch",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "pdfjs-dist": "^6.4.299",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  }
}
